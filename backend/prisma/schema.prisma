generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  UNASSIGNED
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  UNASSIGNED
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(UNASSIGNED)
  priority    TaskPriority @default(UNASSIGNED)
  assignee    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
